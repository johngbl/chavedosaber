# ============================================================
# Escola Chave — variáveis de ambiente
# Copie para `.env` na RAIZ do repositório e ajuste os valores.
# Em produção (Dokploy), defina estas variáveis no painel — o backend
# também lê o .env da raiz, mas variáveis do ambiente têm prioridade.
# ============================================================

# --- Banco de dados (dev = container do docker-compose.yml) ---
DATABASE_URL=postgres://escolachave:escolachave123@localhost:5432/escolachave

# --- Segurança ---
# Gere um segredo forte com: openssl rand -hex 32  (mínimo 16 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# --- Rate limit ---
# true SOMENTE atrás de proxy reverso confiável (nginx do Dokploy), que
# preenche x-forwarded-for/x-real-ip com o IP real. Sem proxy, mantenha false.
TRUST_PROXY=false

# --- Seed (administrador) ---
# A senha DEVE ter 12+ caracteres; o seed recusa senhas fracas.
ADMIN_EMAIL=admin@escolachave.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-12-caracteres
