{
	"name": "backend",
	"version": "1.1.0",
	"scripts": {
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"test:e2e": "bun test src/__tests__/e2e.test.ts",
		"test:unit": "bun test src/__tests__ --exclude-pattern=e2e.test.ts",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"seed": "bun run src/seed.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "1.4.2",
		"drizzle-orm": "^0.45.2",
		"elysia": "1.4.28",
		"jose": "^6.2.3",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"bun-types": "1.3.13",
		"drizzle-kit": "^0.31.10",
		"@types/bun": "^1.3.0",
		"typescript": "^5.9.3"
	},
	"module": "src/index.ts"
}
